GO ?= go
BIN_DIR := bin
TARGET := $(BIN_DIR)/tsart
TSART_CONFIG_DIR ?= $(HOME)/.config/tsart
TSART_BINARY := $(TSART_CONFIG_DIR)/tsart
NVIM_CONFIG_DIR ?= $(HOME)/.config/nvim
NVIM_TSART_PLUGIN := $(NVIM_CONFIG_DIR)/plugin/tsart.vim
NVIM_TSART_LOADER := $(NVIM_CONFIG_DIR)/lua/config/tsart.lua

.PHONY: build install install-nvim-config

# build creates a host-native tsart executable at $(TARGET).
build:
	@mkdir -p $(BIN_DIR)
	$(GO) build -o $(TARGET) .

# install builds tsart, installs its host binary, and installs the Vimscript
# registration as the global Neovim plugin configuration.
install: build install-nvim-config
	mkdir -p $(TSART_CONFIG_DIR)
	cp $(TARGET) $(TSART_BINARY)

# register_plugin.vim is the canonical tsart host configuration and is
# installed globally as Vimscript. .nvimrc only contains local mappings plus a
# source command for working on this repository.
# Keep a small Lua shim so existing init.lua files that require("config.tsart")
# continue to work during and after the migration.
install-nvim-config:
	mkdir -p $(dir $(NVIM_TSART_PLUGIN)) $(dir $(NVIM_TSART_LOADER))
	cp register_plugin.vim $(NVIM_TSART_PLUGIN)
	printf '%s\n' '-- Generated by tsart; edit register_plugin.vim, then run make install.' 'vim.cmd("runtime plugin/tsart.vim")' > $(NVIM_TSART_LOADER)
